# ── Core API Keys ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Auth (Clerk) ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# ── Financial Modeling Prep ───────────────────────────────────────────────────
FMP_API_KEY=your_fmp_api_key_here

# ── Lens Synthesis Engine ─────────────────────────────────────────────────────
# Controls which generation engine runs for new Lens analyses.
# When unset or set to any value other than exactly 'v5', the v4.0 path runs.
# DO NOT set to 'v5' in production until Phase 5 acceptance testing passes.
# LENS_ENGINE_VERSION=v5
# OPENAI_V5_MODEL=gpt-4o-mini  # Model used by v5.0 engine (defaults to gpt-4o-mini)
